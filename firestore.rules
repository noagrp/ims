rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function userExists() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userExists() && userData().status == 'active';
    }

    function hasRole(role) {
      return isActiveUser() && userData().role == role;
    }

    function isAdmin() { return hasRole('admin'); }
    function isManager() { return hasRole('manager'); }
    function isSuperAdmin() { return hasRole('superadmin'); }
    function managerOrSuper() { return isManager() || isSuperAdmin(); }

    function sameCreator() {
      return request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{userId} {
      allow read: if
        (isAuthenticated() && userId == request.auth.uid) ||
        isSuperAdmin() ||
        (isManager() && resource.data.role == 'admin');

      allow create: if
        (
          isSuperAdmin() &&
          request.resource.data.uid == userId &&
          request.resource.data.role in ['admin','manager','superadmin'] &&
          request.resource.data.status == 'active'
        ) ||
        (
          isManager() &&
          request.resource.data.uid == userId &&
          request.resource.data.role == 'admin' &&
          request.resource.data.status == 'active'
        );

      allow update: if
        (
          isManager() &&
          resource.data.role == 'admin' &&
          request.resource.data.role == 'admin' &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.status in ['active','inactive'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        ) ||
        (
          isSuperAdmin() &&
          request.resource.data.email == resource.data.email &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.role in ['admin','manager','superadmin'] &&
          request.resource.data.status in ['active','inactive'] &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role','status'])
        );

      allow delete: if false;
    }

    match /inventory/{itemId} {
      allow read: if isActiveUser();

      allow create: if
        isActiveUser() &&
        request.resource.data.createdBy == userData().email;

      allow update: if
        (
          isAdmin() &&
          request.resource.data.itemCode == resource.data.itemCode &&
          request.resource.data.name == resource.data.name &&
          request.resource.data.category == resource.data.category &&
          (
            !resource.data.keys().hasAll(['createdBy','createdAt']) || sameCreator()
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status','currentLocation','stockBalances','remark','lifecycleHistory',
            'brandId','brand','modelId','model','gradeId','grade','specificationId','specification',
            'lastEditedBy','lastEditedAt'
          ]) &&
          request.resource.data.lastEditedBy == userData().email
        ) ||
        (
          managerOrSuper() &&
          request.resource.data.itemCode == resource.data.itemCode &&
          (
            !resource.data.keys().hasAll(['createdBy','createdAt']) || sameCreator()
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','category','brandId','brand','modelId','model','gradeId','grade','specificationId','specification',
            'status','currentLocation','stockBalances','remark','lifecycleHistory',
            'supplierId','supplierName','lastEditedBy','lastEditedAt'
          ]) &&
          request.resource.data.lastEditedBy == userData().email
        );

      // TEMPORARY testing reset. Remove this delete permission before go-live.
      allow delete: if isSuperAdmin();
    }

    match /operational_logs/{logId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        request.resource.data.performedBy == userData().email &&
        request.resource.data.performedByRole == userData().role &&
        request.resource.data.date is string;
      allow update: if false;
      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /movements/{movementId} {
      allow read: if isActiveUser();

      // Standard movements are created in transit and later marked arrived.
      allow create: if
        (
          isActiveUser() &&
          request.resource.data.createdBy == userData().email &&
          request.resource.data.createdByRole == userData().role &&
          request.resource.data.status == 'in_transit'
        ) ||
        // Lifecycle exits are completed immediately but remain permanent records.
        (
          isActiveUser() &&
          request.resource.data.createdBy == userData().email &&
          request.resource.data.createdByRole == userData().role &&
          request.resource.data.completedBy == userData().email &&
          request.resource.data.status == 'completed' &&
          request.resource.data.qty is number &&
          request.resource.data.qty > 0 &&
          request.resource.data.createdAt is string &&
          request.resource.data.completedAt is string &&
          (
            (
              request.resource.data.action == 'SELL_OWNERSHIP' &&
              request.resource.data.toType == 'sold' &&
              request.resource.data.toStatus == 'Sold' &&
              request.resource.data.clientTransactionType == 'Sale' &&
              request.resource.data.buyerName is string &&
              request.resource.data.currency is string &&
              request.resource.data.unitPrice is number &&
              request.resource.data.unitPrice >= 0 &&
              request.resource.data.totalAmount is number &&
              request.resource.data.totalAmount >= 0
            ) ||
            (
              request.resource.data.action == 'WRITE_OFF' &&
              request.resource.data.toType == 'writeoff' &&
              request.resource.data.toStatus == 'Written Off' &&
              request.resource.data.writeOffReason in [
                'Damaged','Spoiled','Beyond Repair','Lost','Obsolete','Other'
              ]
            )
          )
        );

      allow update: if
        (
          isActiveUser() &&
          resource.data.status == 'in_transit' &&
          request.resource.data.status == 'arrived' &&
          request.resource.data.arrivedBy == userData().email &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status','arrivedAt','arrivedBy'])
        ) ||
        (
          isActiveUser() &&
          resource.data.status == 'in_transit' &&
          request.resource.data.status == resource.data.status &&
          resource.data.createdBy == userData().email &&
          request.resource.data.createdBy == resource.data.createdBy &&
          request.resource.data.createdByRole == resource.data.createdByRole &&
          request.resource.data.itemId == resource.data.itemId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clientTransactionType','periodFrom','periodTo','currency',
            'rateBasis','unitPrice','totalAmount'
          ]) &&
          request.resource.data.clientTransactionType in ['At Client','Rental','Sale'] &&
          request.resource.data.periodFrom is string &&
          request.resource.data.periodTo is string &&
          request.resource.data.currency is string &&
          request.resource.data.rateBasis in ['unit','day','week','month','flat'] &&
          request.resource.data.unitPrice is number &&
          request.resource.data.unitPrice >= 0 &&
          request.resource.data.totalAmount is number &&
          request.resource.data.totalAmount >= 0
        );

      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /maintenance_events/{eventId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        request.resource.data.createdBy == userData().email &&
        request.resource.data.createdByRole == userData().role &&
        request.resource.data.eventType in [
          'Inspection','Preventive Maintenance','Repair','Calibration',
          'Certification / Recertification','Testing','Service','Other'
        ];

      allow update: if
        isActiveUser() &&
        resource.data.createdBy == userData().email &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.createdByRole == resource.data.createdByRole &&
        request.resource.data.itemId == resource.data.itemId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['maintenanceFrom','maintenanceTo']) &&
        request.resource.data.maintenanceFrom is string &&
        request.resource.data.maintenanceTo is string;

      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /document_refs/{documentId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        request.resource.data.createdBy == userData().email &&
        request.resource.data.createdByRole == userData().role &&
        request.resource.data.status == 'current' &&
        request.resource.data.refNumber is string &&
        request.resource.data.docType is string;

      allow update: if
        managerOrSuper() &&
        (
          (
            resource.data.status == 'current' &&
            request.resource.data.status == 'superseded' &&
            request.resource.data.refNumber == resource.data.refNumber &&
            request.resource.data.docType == resource.data.docType &&
            request.resource.data.itemId == resource.data.itemId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status','supersededBy','supersededAt','supersededByUser','supersedeReason'
            ])
          ) ||
          (
            resource.data.status == 'current' &&
            request.resource.data.status == 'current' &&
            request.resource.data.refNumber == resource.data.refNumber &&
            request.resource.data.docType == resource.data.docType &&
            request.resource.data.itemId == resource.data.itemId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'replaces','correctionReason'
            ])
          )
        );

      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /supplier_profiles/{profileId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        request.resource.data.createdBy == userData().email &&
        request.resource.data.status == 'active';
      allow update: if
        managerOrSuper() &&
        (
          !resource.data.keys().hasAll(['createdBy','createdAt']) || sameCreator()
        ) &&
        request.resource.data.status in ['active','inactive'] &&
        request.resource.data.updatedBy == userData().email;
      allow delete: if false;
    }

    match /client_profiles/{profileId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        request.resource.data.createdBy == userData().email &&
        request.resource.data.status == 'active';
      allow update: if
        managerOrSuper() &&
        (
          !resource.data.keys().hasAll(['createdBy','createdAt']) || sameCreator()
        ) &&
        request.resource.data.status in ['active','inactive'] &&
        request.resource.data.updatedBy == userData().email;
      allow delete: if false;
    }

    match /settings/{settingId} {
      allow read: if isActiveUser();

      allow create: if
        managerOrSuper() &&
        request.resource.data.type in ['warehouse','category','unit','brand','model','grade','specification'] &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdBy == userData().email &&
        (
          !(request.resource.data.type in ['brand','model','grade','specification']) ||
          (
            request.resource.data.category is string &&
            request.resource.data.category.size() > 0
          )
        ) &&
        (
          request.resource.data.type != 'model' ||
          !request.resource.data.keys().hasAll(['brand']) ||
          request.resource.data.brand is string
        ) &&
        (
          request.resource.data.type != 'grade' ||
          (
            (!request.resource.data.keys().hasAll(['brand']) || request.resource.data.brand is string) &&
            (!request.resource.data.keys().hasAll(['model']) || request.resource.data.model is string)
          )
        ) &&
        (
          request.resource.data.type != 'specification' ||
          (
            (!request.resource.data.keys().hasAll(['brand']) || request.resource.data.brand is string) &&
            (!request.resource.data.keys().hasAll(['model']) || request.resource.data.model is string) &&
            (!request.resource.data.keys().hasAll(['grade']) || request.resource.data.grade is string)
          )
        );

      allow update: if
        managerOrSuper() &&
        request.resource.data.type == resource.data.type &&
        request.resource.data.value == resource.data.value &&
        (
          !resource.data.keys().hasAll(['category']) || request.resource.data.category == resource.data.category
        ) &&
        (
          !resource.data.keys().hasAll(['brand']) || request.resource.data.brand == resource.data.brand
        ) &&
        (
          !resource.data.keys().hasAll(['model']) || request.resource.data.model == resource.data.model
        ) &&
        (
          !resource.data.keys().hasAll(['grade']) || request.resource.data.grade == resource.data.grade
        ) &&
        (
          !resource.data.keys().hasAll(['normalizedValue']) || request.resource.data.normalizedValue == resource.data.normalizedValue
        ) &&
        request.resource.data.status in ['active','inactive'] &&
        request.resource.data.updatedBy == userData().email &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','updatedAt','updatedBy'
        ]);

      allow delete: if false;
    }

    match /invoices/{invoiceId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        request.resource.data.invoiceId == invoiceId &&
        request.resource.data.side in ['supplier','client'] &&
        request.resource.data.partyId is string &&
        request.resource.data.partyName is string &&
        request.resource.data.invoiceNumber is string &&
        request.resource.data.invoiceDate is string &&
        request.resource.data.currency is string &&
        request.resource.data.invoiceTotal is number &&
        request.resource.data.invoiceTotal >= 0 &&
        request.resource.data.itemisedTotal is number &&
        request.resource.data.itemisedTotal >= 0 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.status == 'current' &&
        request.resource.data.createdBy == userData().email &&
        request.resource.data.createdByRole == userData().role;
      allow update: if false;
      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /audit_traces/{traceId} {
      allow create: if
        isActiveUser() &&
        request.resource.data.performedBy == userData().email &&
        request.resource.data.performedByRole == userData().role;

      allow read: if
        isSuperAdmin() ||
        (
          isManager() &&
          resource.data.performedByRole != 'superadmin' &&
          (
            resource.data.performedByRole == 'admin' ||
            resource.data.performedBy == userData().email
          )
        ) ||
        (
          isAdmin() && resource.data.performedBy == userData().email
        );

      allow update: if false;
      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /client_docs/{docId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        (
          request.resource.data.uploadedBy == userData().email ||
          request.resource.data.recordedBy == userData().email
        );
      allow update: if false;
      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /supplier_docs/{docId} {
      allow read: if isActiveUser();
      allow create: if
        isActiveUser() &&
        (
          request.resource.data.uploadedBy == userData().email ||
          request.resource.data.recordedBy == userData().email
        );
      allow update: if false;
      // TEMPORARY testing reset.
      allow delete: if isSuperAdmin();
    }

    match /attachments/{attachmentId} {
      allow read: if isActiveUser();
      allow create, update, delete: if false;

      match /chunks/{chunkId} {
        allow read: if isActiveUser();
        allow create, update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
